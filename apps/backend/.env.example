NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://hydrafox:changeme@localhost:27017/hydrafox?authSource=admin

# Redis
REDIS_URL=redis://:changeme@localhost:6379

# JWT
JWT_SECRET=change-this-to-a-32-char-minimum-random-secret
JWT_REFRESH_SECRET=change-this-refresh-secret-too

# Admin seed (required only on fresh installs — ignored if admin already exists)
ADMIN_EMAIL=admin@hydrafox.local
ADMIN_PASSWORD=change-this-before-seeding

# OpenAI (HOT leads — gpt-4o)
OPENAI_API_KEY=sk-...

# DeepSeek (WARM batch — deepseek-chat)
DEEPSEEK_API_KEY=sk-...

# AI Cost Control
AI_DAILY_BUDGET_USD=5.00

# Sentry (optional — leave empty in dev)
SENTRY_DSN=

# Outreach identity (injected into AI prompts)
AGENCY_NAME=Your Agency Name
OFFER_SUMMARY=We build websites and automation systems for local businesses
